# Copy to .env and adjust. Everything works offline with defaults (mock providers + dev inbox).
BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-to-a-long-random-string
# ENCRYPTION_KEY=<Fernet key; derived from SECRET_KEY if empty>
DATABASE_URL=sqlite:///./scheduler.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/scheduler   (postgres:// URLs are accepted too)
# ENV=prod   # dev | prod  (prod refuses the default SECRET_KEY and hides the demo login)

# Optional real providers (mock/dev mode is used when blank)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# PayPal webhook id - required to verify PayPal webhooks (unverified events are rejected when ENV=prod)
PAYPAL_WEBHOOK_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AAL Scheduler <no-reply@example.com>
ANTHROPIC_API_KEY=
EMBED_ALLOWED_ORIGINS=*

# Sessions (minutes): idle timeout and absolute lifetime
SESSION_IDLE_MINUTES=4320
SESSION_MAX_AGE_MINUTES=20160
# Legal pages (/privacy, /terms, /data-retention). Bump a version when the text changes.
COMPANY_NAME=AI Automation Labs
PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_VERSION=2026-11-16
TERMS_VERSION=2026-11-16
RETENTION_VERSION=2026-11-16
# Error monitoring (optional)
SENTRY_DSN=
# First owner account for `python seed_prod.py` (idempotent; never overwrites an existing account)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
SEED_WORKSPACE_NAME=
# Observability (optional): error tracking via Sentry when sentry_sdk is installed
SENTRY_DSN=
# Email platform admins after N consecutive failures of a background task
WORKER_ALERT_THRESHOLD=3
# CRM (routing "Salesforce lookup" + activity push). Without these the built-in mock CRM is used.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Notetaker recording bot (Recall.ai-style). Without a key the simulated bot is used.
RECALL_API_KEY=
RECALL_API_BASE=https://us-east-1.recall.ai/api/v1

# Demo workspace + one-click demo login (default: on unless ENV=prod)
DEMO_MODE=
